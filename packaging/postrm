set -e
case "$1" in
  remove) ldconfig; [ -d /run/systemd/system ] && systemctl daemon-reload || true ;;
  purge)
    # State written by platform-detect (links it made, and the first-boot stamp). Customer
    # files in /etc/plugin_discovery/config.d are the customer's and are left alone.
    rm -rf /etc/plugin_discovery/platform.d /var/lib/plugin_discovery
    rmdir /etc/plugin_discovery 2>/dev/null || true
    ;;
esac
exit 0
