# Platform configuration for @PD_MACHINE@ running @PD_PLATFORM@: which camera backends to load.
#
# A candidate: platform-detect links it to /etc/plugin_discovery/platform.d/camera.config.yaml
# when /sys/devices/soc0/machine and the OS type match. The first entry is the default backend;
# the others load too and serve their own cameras in the same process.

domains:
  camera:
    backends: [@PD_CAMERA_BACKENDS_LIST@]
