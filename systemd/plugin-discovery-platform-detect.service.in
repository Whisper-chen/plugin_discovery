[Unit]
Description=Choose the plugin_discovery platform configuration (first boot only)
# Does nothing once it has run; the tool also checks the stamp, this keeps the unit out of the log.
ConditionPathExists=!/var/lib/plugin_discovery/platform-detect.done
RequiresMountsFor=/etc /var/lib

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/platform-detect

[Install]
WantedBy=multi-user.target
